  // init masku. Tracking pak startuje ze stejné masky, kterou vidíš v editoru
  // — člověk + mikrofon zůstane jeden objekt.
  for(let i=0;i<masks.length;i++){
    const m=masks[i];
    const pm=previewMask[i];
    const hasPaint = !!(m._brush && m._painted);
    const hasPreviewInit = !!(pm && pm.raw && (typeof m.keyframe!=='number' || m.keyframe===pm.frame));
    if(!hasPaint && !hasPreviewInit) continue;

    m.prompts=(m.prompts||[]).filter(p=>p.kind!=='brush'); // re-upload čerstvé init PNG
    if(typeof m.keyframe!=='number') m.keyframe=frame;

    if(hasPaint){
      const d=await uploadBrushCanvas(m._brush,'paint_brush.png');
      if(d.ok){ m.prompts.push({kind:'brush',brush_path:d.brush_path,source:'paint'}); }
    }
    if(hasPreviewInit){
      const d=await uploadBrushCanvas(pm.raw,'sam_preview_init.png');
      if(d.ok){ m.prompts.push({kind:'brush',brush_path:d.brush_path,source:'preview'}); }
    }
  }
}
