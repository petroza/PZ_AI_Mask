<script>
const API='api/index.php?action=';
const $=s=>document.querySelector(s);
const token=new URLSearchParams(location.search).get('token');
if(!token) location.href='index.html';

// ---- stav ----
let job=null, masks=[], activeMask=0;
let frame=0, frameCount=0, W=0, H=0;
let tool='point', mode='fg', brushSize=24;
let edgeFeather=0.75, edgeShrink=-1, edgeChoke=0, edgeCleanup=18;
let refineEnable=false, refineHair=78, refineRadius=12, refineFace=68, refineHand=58, refineSmooth=24, refineFeather=0.5, refineChoke=0, refineContrast=18, refineHalo=28, refineEdgeContrast=16;
let refineMode='fast', refineAutoHair=false, refineAutoFace=false, refineBeforeAfter=false, refineBoundaryOverlay=false;
let keyView='normal', keyPreviewCache={sig:'', canvas:null}, brushRev=0;
// V41: při tahání edge/refine sliderů počítáme náhled dočasně v menším rozlišení
// a po puštění/doběhnutí slideru automaticky přepočítáme 100% preview.
let previewInteractiveMode=false, previewFullQualityTimer=null, previewFullQualityBusy=false;
// viewport transform
let zoom=1, panX=0, panY=0;
let img=new Image(), imgLoaded=false;
let instantFirstFrameLoaded=false, instantFirstFrameBusy=false, framesReady=false, warmupRequested=false;
let playing=false, playTimer=null, fps=25;
// brush stav (brush canvas se drží PER MASKU v m._brush)
let painting=false, brushCanvas=null, brushCtx=null;
// undo/redo historie (prompty a stack masek; brush tahy nejsou v historii)
let undoStack=[], redoStack=[];
// rectangle select stav
let recting=false, rectStart=null, rectNow=null;
// náhled masky (SAM)
const previewMask = {};   // mi -> {tinted:Canvas, raw:Canvas, frame:number}
let previewSeq = 0;
let lastPreviewRequest = null;   // V40: pamatuje poslední výběr během prvního stahování SAM modelu
let previewRetryTimer = null;
let livePreviewStamp = '';
let livePreviewPollBusy = false;

const view=$('#view'), ctx=view.getContext('2d'), stage=$('#stage');

function toast(m){const t=$('#toast');t.textContent=m;t.style.display='block';clearTimeout(t._t);t._t=setTimeout(()=>t.style.display='none',2200);}
function fmtPx(v){ return `${(Math.round(v*10)/10).toString().replace(/\.0$/, '')} px`; }
function updateEdgeUi(){
  $('#edgefeatherv').textContent=fmtPx(edgeFeather);
  $('#edgeshrinkv').textContent=`${edgeShrink>0?'+':''}${edgeShrink} px`;
  $('#edgechokev').textContent=`${edgeChoke} px`;
  $('#edgecleanupv').textContent=String(edgeCleanup);
  const set=(id,val)=>{const el=$(id); if(el) el.textContent=val;};
  set('#refinehairv', String(refineHair));
  set('#refineradiusv', `${refineRadius} px`);
  set('#refinefacev', String(refineFace));
  set('#refinehandv', String(refineHand));
  set('#refinesmoothv', String(refineSmooth));
  set('#refinefeatherv', fmtPx(refineFeather));
  set('#refinechokev', `${refineChoke>0?'+':''}${refineChoke} px`);
  set('#refinecontrastv', String(refineContrast));
  set('#refinehalov', String(refineHalo));
  set('#refineedgecontrastv', String(refineEdgeContrast));
  const rb=$('#refinebefore'); if(rb) rb.style.borderColor = refineBeforeAfter ? 'var(--acc)' : 'var(--line)';
  const bo=$('#refineboundary'); if(bo) bo.style.borderColor = refineBoundaryOverlay ? 'var(--acc)' : 'var(--line)';
}
function binaryMorph(src,w,h,mode){
  const dst=new Uint8Array(src.length);
  for(let y=0;y<h;y++){
    for(let x=0;x<w;x++){
      let v=(mode==='erode')?1:0;
      for(let yy=-1;yy<=1;yy++){
        for(let xx=-1;xx<=1;xx++){
          const nx=x+xx, ny=y+yy;
          const n = (nx>=0 && ny>=0 && nx<w && ny<h) ? src[ny*w+nx] : 0;
          if(mode==='erode'){ if(!n){ v=0; yy=2; break; } }
          else { if(n){ v=1; yy=2; break; } }
        }
      }
      dst[y*w+x]=v;
    }
  }
  return dst;
}

// V32: Edge cleanup in the preview must be visible immediately.
// The old preview did only tiny 3x3 open/close passes, so on a normal person
// silhouette it looked like the slider did nothing. This majority/integral pass
// rounds jagged mask borders and removes pinholes/speckles at preview resolution.
function binaryMajority(src,w,h,radius,threshold){
  radius = Math.max(1, radius|0);
  threshold = Math.max(0.05, Math.min(0.95, threshold || 0.5));
  const iw=w+1;
  const integ=new Uint32Array((w+1)*(h+1));
  for(let y=0;y<h;y++){
    let row=0;
    const base=(y+1)*iw, prev=y*iw, off=y*w;
    for(let x=0;x<w;x++){
      row += src[off+x] ? 1 : 0;
      integ[base+x+1] = integ[prev+x+1] + row;
    }
  }
  const dst=new Uint8Array(src.length);
  for(let y=0;y<h;y++){
    const y0=Math.max(0,y-radius), y1=Math.min(h-1,y+radius);
    const ya=y0*iw, yb=(y1+1)*iw;
    for(let x=0;x<w;x++){
      const x0=Math.max(0,x-radius), x1=Math.min(w-1,x+radius);
      const sum = integ[yb+x1+1] - integ[ya+x1+1] - integ[yb+x0] + integ[ya+x0];
      const area = (x1-x0+1)*(y1-y0+1);
      dst[y*w+x] = (sum >= area*threshold) ? 1 : 0;
    }
  }
  return dst;
}
function cleanupPreviewBinary(src,w,h,amount){
  amount = Math.max(0, Math.min(100, +(amount || 0)));
  if(amount <= 0) return src;
  let out = src;
  // V33: cleanup musí být viditelný i na ručně malované brush masce.
  // Proto je rozsah záměrně silnější: šum pryč, díry zavřít, okraj zahladit.
  const morphIt = Math.max(1, Math.min(9, Math.round(1 + amount / 12)));
  for(let k=0;k<morphIt;k++){
    out = binaryMorph(binaryMorph(out,w,h,'erode'),w,h,'dilate'); // remove FG whiskers/noise
    out = binaryMorph(binaryMorph(out,w,h,'dilate'),w,h,'erode'); // close pinholes
  }
  const r = Math.max(1, Math.min(13, Math.round(1 + amount / 8)));
  out = binaryMajority(out,w,h,r,0.50);
  if(amount >= 35) out = binaryMajority(out,w,h,Math.max(1,Math.round(r*0.65)),0.52);
  if(amount >= 70) out = binaryMajority(out,w,h,Math.max(1,Math.round(r*0.45)),0.54);
  return out;
}

function maskBoundaryBinary(bin,w,h,radius){
  radius=Math.max(1,Math.min(20,radius|0));
  let dil=bin, ero=bin;
  for(let k=0;k<radius;k++) dil=binaryMorph(dil,w,h,'dilate');
  for(let k=0;k<radius;k++) ero=binaryMorph(ero,w,h,'erode');
  const bd=new Uint8Array(bin.length);
  for(let i=0;i<bin.length;i++) bd[i]=(dil[i]&&!ero[i])?1:0;
  return {boundary:bd,dilated:dil,eroded:ero};
}
function getPreviewGrayEdges(w,h){
  if(!imgLoaded) return null;
  try{
    const c=document.createElement('canvas'); c.width=w; c.height=h;
    const cx=c.getContext('2d',{willReadFrequently:true}); cx.drawImage(img,0,0,w,h);
    const d=cx.getImageData(0,0,w,h).data;
    const g=new Uint8Array(w*h);
    for(let i=0,j=0;i<d.length;i+=4,j++) g[j]=(d[i]*0.299+d[i+1]*0.587+d[i+2]*0.114)|0;
    const e=new Uint8Array(w*h);
    for(let y=1;y<h-1;y++) for(let x=1;x<w-1;x++){
      const p=y*w+x;
      const gx=-g[p-w-1]-2*g[p-1]-g[p+w-1]+g[p-w+1]+2*g[p+1]+g[p+w+1];
      const gy=-g[p-w-1]-2*g[p-w]-g[p-w+1]+g[p+w-1]+2*g[p+w]+g[p+w+1];
      e[p]=Math.min(255, Math.sqrt(gx*gx+gy*gy)|0);
    }
    return e;
  }catch(_){ return null; }
}
function refinePreviewBinary(bin,w,h){
  if(!refineEnable) return {bin,boundary:null};
  const radius=Math.max(1, Math.min(20, refineRadius|0));
  const workScale = Math.max(0.10, Math.min(1.0, (W&&w) ? (w/W) : 1.0));
  const rpx=Math.max(1, Math.round(radius*workScale));
  const bd=maskBoundaryBinary(bin,w,h,rpx);
  let out=bin.slice ? bin.slice() : new Uint8Array(bin);
  const edges=getPreviewGrayEdges(w,h);
  const hair=(refineHair||0)/100, face=(refineFace||0)/100, hand=(refineHand||0)/100;

  // V55: sleeve / side-body fix.
  // Keep trousers protected, but allow a little more recovery on sleeves and side torso,
  // where background can slightly bite into the silhouette.
  let minX=w, minY=h, maxX=0, maxY=0, any=false;
  for(let i=0;i<out.length;i++) if(out[i]){
    any=true;
    const y=(i/w)|0, x=i-y*w;
    if(x<minX)minX=x;if(x>maxX)maxX=x;if(y<minY)minY=y;if(y>maxY)maxY=y;
  }
  const bw=Math.max(1,maxX-minX+1);
  const bh=Math.max(1,maxY-minY+1);
  const baseBeforeRefine = out.slice ? out.slice() : new Uint8Array(out);

  if(any && edges && (hair>0 || face>0 || hand>0)){
    const rb=bd; // narrow boundary band only
    const lowerBase = Math.max(face, hand, hair) * 0.16;
    for(let i=0;i<out.length;i++){
      if(!rb.boundary[i] || out[i]) continue;
      const y=(i/w)|0, x=i-y*w;
      const rel=(y-minY)/bh;
      const xr=(x-minX)/bw;
      const sideBand = (xr < 0.24 || xr > 0.76);

      // 0.00-0.28  hair / head / hood
      // 0.28-0.44  shoulders / upper torso
      // 0.44-0.70  sleeves / hands / microphone / torso side
      // 0.70-0.88  trousers / legs => protected
      // 0.88-1.06  ankles / feet => mild recovery allowed
      let local=0;
      if(refineAutoHair && rel < 0.28){
        local = Math.max(hair*0.78, face*0.18);
      }else if(refineAutoFace && rel < 0.44){
