function fmtBytesMB(mb){
  if(mb===null || mb===undefined || isNaN(+mb)) return '—';
  const n=+mb;
  return n>=1024 ? (n/1024).toFixed(1)+' GB' : Math.round(n)+' MB';
}
let lastGoodSysStats=null;
function setSysStats(d){
  const el=$('#sysstats'); if(!el) return;

  // FAST HW: neukazovat jen slepé pomlčky. Nejdřív použij živý worker,
  // pak poslední známé hodnoty, a když nejde přečíst nic, vypiš jasně proč.
  const hasVals = x => !!(x && (x.gpu_name || x.gpu_util!==null && x.gpu_util!==undefined || x.cpu_percent!==null && x.cpu_percent!==undefined || x.ram_percent!==null && x.ram_percent!==undefined || x.vram_total_mb!==null && x.vram_total_mb!==undefined));
  if(d && d.ok && hasVals(d)) lastGoodSysStats=d;
  const src = (d && d.ok && d.fresh && hasVals(d)) ? d : lastGoodSysStats;
  if(!src){
    const msg = (d && (d.status_msg || d.error)) ? (d.status_msg || d.error) : 'čekám na worker heartbeat nebo lokální HW čtení';
    el.innerHTML=`<span class="warn" title="${esc(msg)}">HW čekám…</span><span class="stale">spusť worker / kontroluji nvidia-smi</span>`;
    return;
  }

  const fresh = !!(d && d.ok && d.fresh && hasVals(d));
  const gpuName = (src.gpu_name||'').toString().replace(/^NVIDIA\s+/i,'').replace(/GeForce\s+/i,'').trim();
  const gpuUtil = (src.gpu_util!==null && src.gpu_util!==undefined) ? Math.round(+src.gpu_util)+'%' : '—';
  const gpu = gpuName ? `${esc(gpuName)} ${gpuUtil}` : gpuUtil;
  const cpu = (src.cpu_percent!==null && src.cpu_percent!==undefined) ? Math.round(+src.cpu_percent)+'%' : '—';
  const ram = (src.ram_percent!==null && src.ram_percent!==undefined) ? Math.round(+src.ram_percent)+'%' : '—';
  const vu = fmtBytesMB(src.vram_used_mb), vt = fmtBytesMB(src.vram_total_mb);
  const cls = (+src.vram_total_mb && (+src.vram_used_mb/+src.vram_total_mb)>0.92) ? 'bad' : (fresh ? '' : 'stale');
  const maStatus=(src.matanyone_status||'unknown').toString();
  const maBackend=(src.matanyone_backend||'—').toString();
  const maCls = !fresh ? 'stale' : ((maStatus==='ok') ? 'ok' : ((maStatus==='fallback'||maStatus==='fast'||maStatus==='disabled') ? 'warn' : 'stale'));
  const maLabel = maStatus==='ok' ? maBackend : (maStatus==='fast' ? 'FAST' : (maStatus==='fallback' ? 'FALLBACK' : (maStatus==='disabled' ? 'OFF' : '—')));
  const source = (src.stats_source||'').toString();
  const workerFresh = src.worker_fresh !== false;
  const title = esc(src.status_msg || src.matanyone_msg || source || 'HW status');
  const prefix = source.includes('api-local')
    ? `<span class="ok" title="${title}">LOCAL</span>`
    : (workerFresh ? `<span class="ok" title="${title}">LIVE</span>` : `<span class="warn" title="${title}">STALE</span>`);
  el.innerHTML = `${prefix}<span title="${esc(src.gpu_name||'')}">GPU ${gpu}</span><span class="${cls}">VRAM ${vu}/${vt}</span><span>CPU ${cpu}</span><span>RAM ${ram}</span><span class="${maCls}" title="${esc(src.matanyone_msg||'')}">MA ${maLabel}</span>`;
}
