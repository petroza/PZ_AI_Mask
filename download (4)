  const done = !!job && job.status==='done';
  const r = (job && job.results) || {};
  const filesKnown = Array.isArray(r.files);
  const hasFiles = filesKnown && r.files.length>0;
  const dl=$('#dl'), dz=$('#dlpng'), msg=$('#calcmsg');
  let showMain=false, label='Download result'; mainResultKind='mp4';
  if(done){
    if(r.mp4 || (!filesKnown && !r.mov && !r.png_zip)){ showMain=true; label='Download .mp4'; mainResultKind='mp4'; }
    else if(r.mov){ showMain=true; label='Download .mov'; mainResultKind='mov'; }
    else if(r.zip && !r.png_zip){ showMain=true; label='Download ZIP'; mainResultKind='zip'; }
  }
  if(dl){ dl.style.display=showMain?'flex':'none'; const l=$('#dllabel'); if(l) l.textContent=label; }
  if(dz) dz.style.display=(done && !!r.png_zip)?'flex':'none';
  if(done && filesKnown && !hasFiles && msg) msg.textContent='Done, ale API nenašlo soubor výsledku.';
}

// ============================ framy ============================
function sourceVideoUrl(){return `api/index.php?action=source-video&token=${encodeURIComponent(token)}`;}

function loadInstantFirstFrame(){
  if(instantFirstFrameLoaded || instantFirstFrameBusy || (job && job.source_type!=='video')) return;
  instantFirstFrameBusy = true;
  const v=document.createElement('video');
  v.preload='auto';
  v.muted=true;
  v.playsInline=true;
  v.src=sourceVideoUrl()+'&_=' + Date.now();

  const fail=()=>{ instantFirstFrameBusy=false; if(!framesReady) $('#notready').style.display='grid'; };
  const capture=()=>{
    try{
      const vw=v.videoWidth||0, vh=v.videoHeight||0;
      if(!vw || !vh){ fail(); return; }
      const c=document.createElement('canvas');
      c.width=vw; c.height=vh;
      const cx=c.getContext('2d', {willReadFrequently:false});
      cx.drawImage(v,0,0,vw,vh);
      img=c; imgLoaded=true; instantFirstFrameLoaded=true; instantFirstFrameBusy=false;
      W=vw; H=vh; if(!frameCount) frameCount=1; frame=0;
      $('#scrub').max=Math.max(0,frameCount-1);
      $('#scrub').value=0; $('#fcount').textContent=`0 / ${Math.max(0,frameCount-1)}`;
      $('#notready').style.display='none';
      $('#status').textContent=`${job.source_type} · ${W}×${H} · instant first frame`;
      fitView(); renderMasks(); draw();
      warmupFirstPreview();
      try{ v.pause(); v.removeAttribute('src'); v.load(); }catch(_){ }
    }catch(_){ fail(); }
  };

  v.addEventListener('loadedmetadata',()=>{
    // nula někdy vrací ještě černý buffer; malý seek drží první obrazový frame.
    try{ v.currentTime = Math.min(0.001, Math.max(0, (v.duration||1)-0.001)); }catch(_){ }
  },{once:true});
  v.addEventListener('seeked',capture,{once:true});
  v.addEventListener('loadeddata',()=>{ setTimeout(()=>{ if(!instantFirstFrameLoaded) capture(); }, 0); },{once:true});
  v.addEventListener('error',fail,{once:true});
}

function frameUrl(i){return `api/index.php?action=frame&token=${token}&i=${i}`;}
function loadFrame(i){
  if(instantFirstFrameLoaded && !framesReady && (+i||0)===0){
    frame=0; $('#scrub').value=0; $('#fcount').textContent=`0 / ${Math.max(0,frameCount-1)}`; draw(); return;
  }
  frame=Math.max(0,Math.min(frameCount-1,i));
  // náhledy patří ke konkrétnímu framu → při změně je zahoď
  for(const k in previewMask) delete previewMask[k];
  keyPreviewCache={sig:'',canvas:null};
  previewSeq++;
  $('#scrub').value=frame;
  $('#fcount').textContent=`${frame} / ${Math.max(0,frameCount-1)}`;
  renderTicks();
  img=new Image();
  img.onload=()=>{ imgLoaded=true; if(!W){W=img.naturalWidth;H=img.naturalHeight;} fitView(); draw(); };
  img.onerror=()=>{ imgLoaded=false; draw(); };
  img.src=frameUrl(frame);
}

// ============================ viewport transform ============================
function resize(){ view.width=stage.clientWidth; view.height=stage.clientHeight; draw(); }
function fitView(){
  if(!W||!H) return;
  const s=Math.min(view.width/W, view.height/H);
  zoom=s; panX=(view.width-W*s)/2; panY=(view.height-H*s)/2;
}
function imgToScreen(x,y){return [x*zoom+panX, y*zoom+panY];}
function screenToImg(sx,sy){return [(sx-panX)/zoom, (sy-panY)/zoom];}

function draw(){
  ctx.clearRect(0,0,view.width,view.height);
  const keyPreviewCanvas = getKeyPreviewCanvas();
  if(imgLoaded){
    ctx.imageSmoothingEnabled = zoom<2;
    ctx.drawImage(keyPreviewCanvas || img, panX, panY, W*zoom, H*zoom);
  }
  // brush vrstvy všech masek (aktivní jasnější)
  masks.forEach((m,mi)=>{
    if(m._brush){
      if(keyPreviewCanvas && mi===activeMask) return;
      ctx.globalAlpha = mi===activeMask?0.5:0.28;
      ctx.drawImage(m._brush, panX, panY, W*zoom, H*zoom);
      ctx.globalAlpha=1;
    }
  });
  // náhledy masek (SAM výsledek pro keyframe) — tónované barvou masky
  masks.forEach((m,mi)=>{
    const pm=previewMask[mi];
    if(pm && pm.tinted){
      if(keyPreviewCanvas && mi===activeMask && pm.frame===frame) return;
      ctx.globalAlpha=mi===activeMask?0.55:0.30;
      ctx.drawImage(pm.tinted, panX, panY, W*zoom, H*zoom);
      ctx.globalAlpha=1;
    }
  });
  // prompty: body + Photoshop-like obdélník
  masks.forEach((m,mi)=>{
    const col=m.color||'#33dd88';
    (m.prompts||[]).forEach(p=>{
      if(p.kind==='point'){
        const [sx,sy]=imgToScreen(p.x*W, p.y*H);
        ctx.beginPath();ctx.arc(sx,sy,mi===activeMask?6:4,0,7);
        ctx.fillStyle=+p.val? (col):'#ff5d5d';
        ctx.fill();ctx.lineWidth=2;ctx.strokeStyle='#fff';ctx.stroke();
      }else if(p.kind==='box'){
        const [x0,y0]=imgToScreen(p.x0*W,p.y0*H), [x1,y1]=imgToScreen(p.x1*W,p.y1*H);
        ctx.save();ctx.strokeStyle=col;ctx.lineWidth=mi===activeMask?3:2;ctx.setLineDash([8,5]);
        ctx.strokeRect(Math.min(x0,x1),Math.min(y0,y1),Math.abs(x1-x0),Math.abs(y1-y0));
        ctx.restore();
      }
    });
  });
  if(recting && rectStart && rectNow){
    const col=(masks[activeMask]&&masks[activeMask].color)||'#33dd88';
    const [x0,y0]=imgToScreen(rectStart.x,rectStart.y), [x1,y1]=imgToScreen(rectNow.x,rectNow.y);
    ctx.save();ctx.strokeStyle=col;ctx.lineWidth=3;ctx.setLineDash([10,5]);
    ctx.strokeRect(Math.min(x0,x1),Math.min(y0,y1),Math.abs(x1-x0),Math.abs(y1-y0));
    ctx.restore();
  }
  // HUD
  $('#hud').innerHTML=`zoom ${(zoom*100|0)}% · frame ${frame}<br>mask ${masks.length?activeMask+1:0}/${masks.length} · view ${keyView}${previewInteractiveMode?' · quick edge preview':' · 100% edge preview'}`;
}

function expandRectHeldPrompts(pts){
  // V51: Rectangle is no longer just a loose SAM box. We add invisible
  // positive points through the person and negative points in the rectangle
  // corners/background. First rectangle selection becomes much tighter.
  const on = $('#rectheld') ? $('#rectheld').checked : true;
  if(!on || !pts || !pts.length) return pts;
  const out = pts.slice();
  const clamp01=v=>Math.max(0,Math.min(1,+v||0));
  pts.filter(p=>p.kind==='box').forEach(b=>{
    const x0=Math.min(+b.x0,+b.x1), x1=Math.max(+b.x0,+b.x1);
    const y0=Math.min(+b.y0,+b.y1), y1=Math.max(+b.y0,+b.y1);
    const w=x1-x0, h=y1-y0;
    if(w<=0.02 || h<=0.02) return;

    // Strong FG spine: head, face, chest, microphone/hands, legs.
    const fg=[
      [0.50,0.16],[0.50,0.25],[0.50,0.38],[0.50,0.52],
      [0.50,0.64],[0.50,0.76],[0.44,0.35],[0.56,0.35],
      [0.42,0.58],[0.58,0.58],[0.43,0.70],[0.57,0.70]
    ];
    fg.forEach(([rx,ry])=>{
      const x=clamp01(x0+w*rx), y=clamp01(y0+h*ry);
      out.push({kind:'point',x,y,val:1,auto:1});
    });

    // BG anchors: corners and side background. They are still inside/near the
    // user rectangle, so SAM learns "this rectangle contains the person, not all pixels".
    const bg=[
      [0.06,0.08],[0.94,0.08],[0.06,0.92],[0.94,0.92],
      [0.04,0.50],[0.96,0.50],[0.16,0.22],[0.84,0.22],
      [0.16,0.84],[0.84,0.84]
    ];
    bg.forEach(([rx,ry])=>{
      const x=clamp01(x0+w*rx), y=clamp01(y0+h*ry);
      out.push({kind:'point',x,y,val:0,auto:1});
    });

    // A few outside negatives, only if they stay in the image.
    const m=Math.min(0.08, Math.max(0.025, Math.min(w,h)*0.12));
    [[x0-m,y0+h*0.50],[x1+m,y0+h*0.50],[x0+w*0.50,y0-m],[x0+w*0.50,y1+m]].forEach(([x,y])=>{
      x=clamp01(x); y=clamp01(y);
      out.push({kind:'point',x,y,val:0,auto:1});
    });
  });
  return out;
}

// ============================ náhled masky (SAM) ============================
async function warmupFirstPreview(){
  if(warmupRequested || !job || job.source_type!=='video' || !instantFirstFrameLoaded) return;
  warmupRequested=true;
  try{
    await fetch(API+'preview/warmup',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({token, frame_index:0, sam_model:$('#sammodel').value})});
  }catch(_){ /* warmup je jen zrychlení, UI kvůli tomu neblokujeme */ }
}

let previewRequestTimer=null;
function schedulePreviewRequest(delay=70){
  if(previewRequestTimer) clearTimeout(previewRequestTimer);
  previewRequestTimer=setTimeout(()=>{
    previewRequestTimer=null;
    requestPreview();
  }, Math.max(0, delay|0));
}

async function requestPreview(){
  // První mask u videa musí běžet hned z full-quality prvního framu.
  // Nesmí čekat na rozbalení celé sekvence. Další framy používají preview až po extrakci.
  const canInstantPreview = !!job && job.source_type==='video' && instantFirstFrameLoaded && frame===0;
  if(!framesReady && !canInstantPreview){ setPreviewBusy(false); draw(); return; }
  const mi = activeMask;
  const m = masks[mi];
  if(!m) return;
  const pts = expandRectHeldPrompts((m.prompts||[]).filter(p=>p.kind==='point'||p.kind==='box')
                .map(p=>p.kind==='box'
                  ? {kind:'box',x0:p.x0,y0:p.y0,x1:p.x1,y1:p.y1}
                  : {kind:'point',x:p.x,y:p.y,val:p.val}));
  if(!pts.length){ delete previewMask[mi]; draw(); return; }

  const mySeq = ++previewSeq;
  delete previewMask[mi]; // nespouštěj RUN se starou init maskou po změně bodů/boxu
  if(previewRetryTimer){ clearTimeout(previewRetryTimer); previewRetryTimer=null; }
  draw();
  setPreviewBusy(true, 'preview…');
  try{
    // 1) vytvoř náhledový požadavek
    const reqBody = {token, frame_index:frame, sam_model:$('#sammodel').value, points:pts};
    lastPreviewRequest = {maskIndex:mi, frame, reqBody, createdAt:Date.now()};
    const r = await (await fetch(API+'preview/request',{method:'POST',
      headers:{'Content-Type':'application/json'}, body:JSON.stringify(reqBody)})).json();
    if(!r.ok){ setPreviewBusy(false); return; }
    const pid = r.preview_id;

    // 2) poll na výsledek. V40: první spuštění může teprve stahovat SAM model,
    // což trvá výrazně déle než běžný preview. Výběr objektu proto držíme v paměti
    // a čekáme dál, aby uživatel nemusel po stažení modelu klikat znovu.
    let url=null;
    const maxPolls = 3600; // cca 30 min při 500 ms; další preview po načtení už bývá rychlé
    for(let i=0;i<maxPolls;i++){
      if(mySeq!==previewSeq) return;          // přišlo novější kliknutí → zahoď
      await sleep(i<20 ? 150 : 500);
      if(i===20) setPreviewBusy(true, 'loading model… selection saved');
      if(i===80) setPreviewBusy(true, 'first run: downloading SAM model…');
      if(i===240) setPreviewBusy(true, 'still downloading model… selection kept');
      let d=null;
      try{
        d = await (await fetch(API+'preview/result&id='+pid+'&_='+Date.now())).json();
      }catch(_){
        if(i%20===0) setPreviewBusy(true, 'waiting for preview server…');
        continue;
      }
      if(d.status==='done'){ url=d.mask_url; break; }
      if(d.status==='error'){
        // Warmup nebo starší request může skončit jako error. U reálného výběru
        // zkusíme po doběhnutí modelu automatický retry se stejnými body/boxem.
        setPreviewBusy(false);
        if((d.error||'').toLowerCase().includes('warmup')) schedulePreviewRetry('Model se nahřál, zkouším výběr znovu…');
        return;
      }
    }
    if(!url){
      setPreviewBusy(false);
      toast('Preview stále čeká na model — výběr zůstává uložený.');
      schedulePreviewRetry('Zkouším uložený výběr znovu…');
      return;
    }

    // 3) načti PNG masku a obarvi ji na barvu masky
    if(mySeq!==previewSeq) return;
    const mimg = new Image();
    mimg.onload=()=>{
      if(mySeq!==previewSeq) return;
      previewMask[mi] = {
        tinted: tintMask(mimg, m.color||'#33dd88'),
        raw: rawMaskCanvas(mimg),
        frame
      };
      keyPreviewCache={sig:'',canvas:null};
      setPreviewBusy(false);
      if(lastPreviewRequest && lastPreviewRequest.maskIndex===mi) lastPreviewRequest=null;
      draw();
    };
    mimg.onerror=()=>setPreviewBusy(false);
    mimg.src = url + '&_=' + Date.now();    // anti-cache
  }catch(_){ setPreviewBusy(false); }
}

// čistá grayscale/alfa mask pro uložení jako init PNG pro tracking
function rawMaskCanvas(maskImg){
  const c=document.createElement('canvas'); c.width=W; c.height=H;
  const cx=c.getContext('2d');
  cx.drawImage(maskImg,0,0,W,H);
  const id=cx.getImageData(0,0,W,H), px=id.data;
  for(let i=0;i<px.length;i+=4){
    const a=px[i];
    px[i]=255; px[i+1]=255; px[i+2]=255; px[i+3]=a;
  }
  cx.putImageData(id,0,0);
  return c;
}

// bílá mask → plná barva tam, kde je mask (alfa = jas masky)
function tintMask(maskImg, hex){
  const c=document.createElement('canvas'); c.width=W; c.height=H;
  const cx=c.getContext('2d');
  cx.drawImage(maskImg,0,0,W,H);
  const id=cx.getImageData(0,0,W,H), px=id.data;
  const rgb=hexToRgb(hex);
  for(let i=0;i<px.length;i+=4){
    const a=px[i];                 // jas (mask je grayscale)
    px[i]=rgb.r; px[i+1]=rgb.g; px[i+2]=rgb.b; px[i+3]=a;
  }
  cx.putImageData(id,0,0);
  return c;
}
function hexToRgb(h){ const n=parseInt(h.replace('#',''),16);
  return {r:(n>>16)&255,g:(n>>8)&255,b:n&255}; }
function setPreviewBusy(b, msg){
  const el=$('#prevbusy');
  if(!el) return;
  el.style.display=b?'inline':'none';
  if(b) el.textContent = msg || 'preview…';
}
function invalidatePreview(all=false){
  // V51: one hard refresh path for tool switches, deleting masks and changing prompt mode.
  // This prevents stale SAM/key-preview canvases from being drawn after UI changes.
  if(previewRequestTimer){ clearTimeout(previewRequestTimer); previewRequestTimer=null; }
  if(previewRetryTimer){ clearTimeout(previewRetryTimer); previewRetryTimer=null; }
  previewSeq++;
  keyPreviewCache={sig:'',canvas:null};
  if(all){ for(const k in previewMask) delete previewMask[k]; }
  else { delete previewMask[activeMask]; }
  setPreviewBusy(false);
}
function schedulePreviewRetry(reason){
  if(previewRetryTimer) clearTimeout(previewRetryTimer);
  // V40: když se při prvním použití teprve stahuje/načítá SAM model,
  // uživatelův bod/rectangle nezahodíme. Jakmile model doběhne, zkusíme
  // stejný uložený výběr automaticky znovu.
  if(!lastPreviewRequest) return;
  previewRetryTimer = setTimeout(()=>{
    previewRetryTimer=null;
    const lr=lastPreviewRequest;
    if(!lr || lr.maskIndex!==activeMask) return;
    const m=masks[activeMask];
    if(!m || !(m.prompts||[]).some(p=>p.kind==='point'||p.kind==='box')) return;
    if(previewMask[activeMask] && previewMask[activeMask].frame===frame) return;
    toast(reason || 'Model je připravený, zkouším náhled znovu…');
    schedulePreviewRequest(50);
  }, 3500);
}
function sleep(ms){ return new Promise(r=>setTimeout(r,ms)); }

// ============================ interakce viewport ============================
stage.addEventListener('wheel',e=>{
  e.preventDefault();
  const r=view.getBoundingClientRect(), mx=e.clientX-r.left, my=e.clientY-r.top;
  const [ix,iy]=screenToImg(mx,my);
  const f=e.deltaY<0?1.12:1/1.12;
  zoom=Math.max(0.05,Math.min(40,zoom*f));
  panX=mx-ix*zoom; panY=my-iy*zoom;
  draw();
},{passive:false});

let pan=false,pl=0,pt=0;
stage.addEventListener('mousedown',e=>{
  const r=view.getBoundingClientRect(), mx=e.clientX-r.left, my=e.clientY-r.top;
  // pan: prostřední tlačítko nebo Alt+levé
  if(e.button===1 || (e.button===0 && e.altKey)){ pan=true;pl=mx;pt=my;e.preventDefault();return; }
  if(!imgLoaded || !ensureMask()) return;
  if(tool==='point'){
    if(e.button===2){ removeNearestPoint(mx,my); e.preventDefault(); return; }
    const [ix,iy]=screenToImg(mx,my);
    if(ix<0||iy<0||ix>W||iy>H) return;
    const val = (mode==='fg'?1:0);
    pushHistory();
    masks[activeMask].prompts=masks[activeMask].prompts||[];
    // Keyframe masky musí odpovídat framu, na kterém vznikl první prompt.
    // Jinak by worker poslal body do SAM2 na špatný frame.
    if(!masks[activeMask].prompts.length) masks[activeMask].keyframe=frame;
    masks[activeMask].prompts.push({kind:'point',x:ix/W,y:iy/H,val});
    draw(); renderMasks();
    schedulePreviewRequest(30);  // V50: tiny debounce = smoother refresh, less duplicate preview churn
  } else if(tool==='rect'){
    const [ix,iy]=screenToImg(mx,my);
    if(ix<0||iy<0||ix>W||iy>H) return;
    recting=true; rectStart={x:Math.max(0,Math.min(W,ix)),y:Math.max(0,Math.min(H,iy))}; rectNow={...rectStart};
    e.preventDefault();
  } else if(tool==='brush'){
    const m=masks[activeMask];
    if(m && !m._painted && !(m.prompts||[]).length) m.keyframe=frame;
    painting=true; ensureBrushCanvas(); paintAt(mx,my);
  }
});
window.addEventListener('mousemove',e=>{
  const r=view.getBoundingClientRect(), mx=e.clientX-r.left, my=e.clientY-r.top;
  if(pan){ panX+=mx-pl;panY+=my-pt;pl=mx;pt=my;draw();return; }
  if(recting){ const [ix,iy]=screenToImg(mx,my); rectNow={x:Math.max(0,Math.min(W,ix)),y:Math.max(0,Math.min(H,iy))}; draw(); return; }
  if(painting){ paintAt(mx,my); }
});
window.addEventListener('mouseup',()=>{
  if(recting && rectStart && rectNow && masks[activeMask]){
    const x0=Math.max(0,Math.min(W,rectStart.x)), y0=Math.max(0,Math.min(H,rectStart.y));
    const x1=Math.max(0,Math.min(W,rectNow.x)), y1=Math.max(0,Math.min(H,rectNow.y));
    if(Math.abs(x1-x0)>8 && Math.abs(y1-y0)>8){
      const m=masks[activeMask]; m.prompts=m.prompts||[];
      pushHistory();
      if(!m.prompts.length) m.keyframe=frame;
      m.prompts.push({kind:'box',x0:x0/W,y0:y0/H,x1:x1/W,y1:y1/H,val:1});
      renderMasks(); draw(); schedulePreviewRequest(40);
    }
  }
  pan=false; painting=false; recting=false; rectStart=null; rectNow=null; draw();
});
stage.addEventListener('contextmenu',e=>e.preventDefault());
function clickTool(name){ const b=document.querySelector(`[data-tool="${name}"]`); if(b) b.click(); }
function clickMode(name){ const b=document.querySelector(`[data-mode="${name}"]`); if(b) b.click(); }
function clearActiveMask(){
  const m=masks[activeMask]; if(!m) return;
  if(!(m.prompts||[]).length && !m._painted){ toast('Mask already empty'); return; }
  pushHistory();
  m.prompts=[]; m._brush=null; m._painted=false; brushRev++; keyPreviewCache={sig:'',canvas:null}; delete previewMask[activeMask];
  loadActiveBrush(); renderMasks(); draw(); toast('Mask cleared');
}
function zoomBy(f){
  const cx=view.width/2, cy=view.height/2;
  const [ix,iy]=screenToImg(cx,cy);
  zoom=Math.max(0.05,Math.min(40,zoom*f));
  panX=cx-ix*zoom; panY=cy-iy*zoom; draw();
}
window.addEventListener('keydown',e=>{
  const tgt=e.target;
  if(tgt && /^(INPUT|SELECT|TEXTAREA)$/.test(tgt.tagName||'')) return;
  const k=e.key;
  if((e.ctrlKey||e.metaKey) && (k==='z'||k==='Z')){ e.preventDefault(); e.shiftKey?redo():undo(); return; }
  if((e.ctrlKey||e.metaKey) && (k==='y'||k==='Y')){ e.preventDefault(); redo(); return; }
  if(e.ctrlKey||e.metaKey) return;
  switch(k){
    case 'f': case 'F': fitView(); draw(); break;
    case 'p': case 'P': clickTool('point'); break;
    case 'r': case 'R': clickTool('rect'); break;
    case 'b': case 'B': clickTool('brush'); break;
    case 'x': case 'X': clickMode(mode==='fg'?'bg':'fg'); break;
    case ' ': e.preventDefault(); playing?stopPlay():startPlay(); break;
    case 'ArrowLeft': e.preventDefault(); stopPlay(); loadFrame(frame-1); break;
    case 'ArrowRight': e.preventDefault(); stopPlay(); loadFrame(frame+1); break;
    case '[': brushSize=Math.max(2,brushSize-2); $('#brush').value=brushSize; $('#brushv').textContent=brushSize; break;
    case ']': brushSize=Math.min(100,brushSize+2); $('#brush').value=brushSize; $('#brushv').textContent=brushSize; break;
    case '+': case '=': zoomBy(1.15); break;
