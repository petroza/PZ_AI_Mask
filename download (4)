function removeNearestPoint(mx,my){
  const m=masks[activeMask];
  if(!m || !(m.prompts||[]).length) return false;
  let best=-1, bestD=1e9;
  (m.prompts||[]).forEach((p,i)=>{
    if(p.kind!=='point') return;
    const [sx,sy]=imgToScreen((p.x||0)*W,(p.y||0)*H);
    const d=Math.hypot(sx-mx, sy-my);
