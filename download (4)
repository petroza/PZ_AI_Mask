<svg class="iconset" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><defs>
  <symbol id="i-point" viewBox="0 0 24 24"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2.2" fill="currentColor" stroke="none"/><path d="M12 1.5v3.2M12 19.3v3.2M1.5 12h3.2M19.3 12h3.2"/></symbol>
