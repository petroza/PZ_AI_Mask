<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PZ MASK — Editor</title>
<link rel="icon" type="image/svg+xml" href="favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#070a0d; --panel:#0e1419; --panel2:#131b22; --line:#1e2932; --line2:#2c3a45;
    --ink:#e9f1f7; --dim:#7e8c9a; --acc:#2fe39a; --acc2:#28b6ff;
    --warn:#ffb454; --err:#ff5d5d;
  }
  *{box-sizing:border-box}
  html,body{height:100%}
  body{margin:0;background:var(--bg);color:var(--ink);
    font-family:'Space Grotesk',system-ui,sans-serif;overflow:hidden;-webkit-font-smoothing:antialiased}
  .mono{font-family:'JetBrains Mono',monospace}
  /* layout */
  .app{display:grid;grid-template-rows:48px 1fr auto;height:100vh}
  .topbar{display:flex;align-items:center;gap:14px;padding:0 14px;background:var(--panel);
    border-bottom:1px solid var(--line)}
  .topbar a.back{color:var(--dim);font-size:13px}
  .topbar .title{font-weight:800;font-size:15px}
  .topbar .sysstats{margin-left:auto;display:flex;align-items:center;gap:8px;font-size:11px;font-family:'JetBrains Mono',monospace;color:#b8c6d2;white-space:nowrap}
  .topbar .sysstats .bad{color:var(--err)}
  .topbar .sysstats .stale{color:var(--dim)}
  .topbar .sysstats .ok{color:var(--ok)}
  .topbar .sysstats .warn{color:var(--warn)}
  .topbar .status{font-size:11px;font-family:'JetBrains Mono',monospace;color:var(--dim);white-space:nowrap}
  .topbar .queueinfo{font-size:11px;font-family:'JetBrains Mono',monospace;white-space:nowrap;border:1px solid var(--line);border-radius:999px;padding:3px 8px;background:#0a1015;color:var(--dim)}
  .topbar .queueinfo.running{color:var(--warn);border-color:#5a4420;background:#241b0a}
  .topbar .queueinfo.waiting{color:#ffd580;border-color:#66481e;background:#2a1d0b}
  .topbar .queueinfo.idle{color:var(--dim)}
  .topbar .queueinfo.error{color:var(--err);border-color:#5a2020;background:#240a0a}
  .pill{font-family:'JetBrains Mono',monospace;font-size:10px;padding:3px 9px;border-radius:99px;
    text-transform:uppercase;letter-spacing:.5px;border:1px solid;margin-left:8px}
  .pill.created,.pill.ready{color:var(--acc2);border-color:#1f4a66;background:#0a1c28}
  .pill.queued,.pill.claimed,.pill.extracting,.pill.tracking,.pill.matting,.pill.rmbg{color:var(--warn);border-color:#5a4420;background:#241b0a}
  .pill.done{color:var(--acc);border-color:#1f5a3a;background:#0a2417}
  .pill.error{color:var(--err);border-color:#5a2020;background:#240a0a}

  .main{display:grid;grid-template-columns:minmax(0,1fr) clamp(430px,27vw,520px);min-height:0}
  /* viewport */
  .stage{position:relative;background:
      repeating-conic-gradient(#0c1116 0% 25%, #0a0e12 0% 50%) 50%/22px 22px;
    overflow:hidden;cursor:crosshair}
  #view{position:absolute;inset:0;width:100%;height:100%;display:block}
  .vp-hud{position:absolute;left:10px;top:10px;font-family:'JetBrains Mono',monospace;font-size:10px;
    color:var(--dim);background:rgba(7,10,13,.7);padding:5px 9px;border-radius:6px;border:1px solid var(--line);
    pointer-events:none;line-height:1.6}
  .vp-help{position:absolute;right:10px;bottom:10px;font-family:'JetBrains Mono',monospace;font-size:10px;
    color:var(--dim);background:rgba(7,10,13,.7);padding:6px 10px;border-radius:6px;border:1px solid var(--line);
    pointer-events:none;text-align:right;line-height:1.7}
  .notready{position:absolute;inset:0;display:grid;place-items:center;text-align:center}
  .notready .box{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:30px 36px;max-width:380px}
  /* side panel */
  .side{background:var(--panel);border-left:1px solid var(--line);overflow-y:auto;display:flex;flex-direction:column}
  .sec{padding:14px;border-bottom:1px solid var(--line)}
  .sec h3{margin:0 0 10px;font-size:11px;text-transform:uppercase;letter-spacing:1.4px;color:var(--dim);font-weight:700}
  .tools{display:flex;gap:8px;flex-wrap:wrap}
  .tool{flex:1;min-width:0;background:#0d1217;border:1px solid var(--line);color:var(--ink);
    padding:9px 6px;border-radius:8px;cursor:pointer;font-size:12px;font-weight:600;transition:.12s;text-align:center}
  .tool:hover{border-color:var(--line2)}
  .tool.on{background:#0e1a14;border-color:var(--acc);color:var(--acc)}
  .tool.on.bg{background:#1a0e0e;border-color:var(--err);color:var(--err)}
  .row{display:flex;align-items:center;gap:10px;margin-top:10px;font-size:12px;color:var(--dim)}
  .row input[type=range]{flex:1;accent-color:var(--acc);min-width:0;height:22px}
  select,.fld{width:100%;background:#0d1217;border:1px solid var(--line);color:var(--ink);
    padding:8px 10px;border-radius:7px;font-family:'Space Grotesk';font-size:13px;margin-top:6px}
  label.lbl{font-size:11px;color:var(--dim);display:block;margin-top:10px;font-family:'JetBrains Mono',monospace}
  .chk{display:flex;align-items:center;gap:8px;margin-top:10px;font-size:13px;cursor:pointer}
  .chk input{accent-color:var(--acc);width:16px;height:16px}
  .row .mono{min-width:58px;text-align:right;background:#0a1015;border:1px solid var(--line);border-radius:6px;padding:3px 6px;color:#d7e6ef}
  .mini{background:#0d1217;border:1px solid var(--line);color:var(--ink);border-radius:7px;padding:7px 9px;font-family:'Space Grotesk';font-size:12px;font-weight:700;cursor:pointer}
  .mini:hover{border-color:var(--acc);color:var(--acc)}
  .edge-actions{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:12px}
  .edge-note{font-size:10px;color:var(--dim);letter-spacing:.4px;text-transform:uppercase}
  .edge-help{font-size:10px;color:var(--dim);line-height:1.45;margin-top:8px;font-family:'JetBrains Mono',monospace}
  .refine-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
  .refine-grid .mini{width:100%;padding:8px 6px}
  .refine-sub{display:flex;gap:8px;align-items:center;margin-top:8px}
  .refine-sub select{margin-top:0;flex:1}
  .badge{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--dim);border:1px solid var(--line);border-radius:99px;padding:4px 7px;background:#0a1015}
  /* mask stack */
  .masks{display:flex;flex-direction:column;gap:7px}
  .mk{display:flex;align-items:center;gap:10px;background:#0d1217;border:1px solid var(--line);
    border-radius:8px;padding:8px 10px;cursor:pointer;transition:.12s}
  .mk.on{border-color:var(--acc2);background:#0a141c}
  .sw{width:16px;height:16px;border-radius:5px;flex:none;border:1px solid rgba(255,255,255,.25)}
  .mk .nm{flex:1;font-size:13px;font-weight:600}
  .mk .cnt{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--dim)}
  .mk .x{color:var(--dim);font-size:16px;line-height:1;padding:0 2px}
  .mk .x:hover{color:var(--err)}
  .btn{display:flex;align-items:center;justify-content:center;gap:8px;background:var(--acc);color:#05120c;border:0;
    padding:11px 14px;border-radius:8px;font-weight:700;cursor:pointer;font-family:'Space Grotesk';font-size:14px;
    transition:.15s;width:100%}
  .btn:hover{filter:brightness(1.08)}
  .btn[disabled]{opacity:.45;cursor:not-allowed}
  .btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
  .btn.blue{background:var(--acc2);color:#04141f}
  .btn+.btn{margin-top:8px}
  /* timeline */
  .timeline{background:var(--panel);border-top:1px solid var(--line);padding:10px 14px;
    display:flex;align-items:center;gap:12px}
  .tl-btn{background:#0d1217;border:1px solid var(--line);color:var(--ink);width:36px;height:34px;
    border-radius:8px;cursor:pointer;font-size:14px;display:grid;place-items:center}
  .tl-btn:hover{border-color:var(--line2)}
  #scrub{flex:1;accent-color:var(--acc2)}
  .scrubwrap{position:relative;flex:1;display:flex;align-items:center}
  .scrubwrap #scrub{flex:1;width:100%}
  #tlticks{position:absolute;left:0;right:0;top:-7px;height:6px;pointer-events:none}
  #tlticks .kf{position:absolute;top:0;width:2px;height:6px;background:var(--acc);border-radius:1px;transform:translateX(-1px);box-shadow:0 0 4px rgba(47,227,154,.6)}
  .fcount{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--dim);min-width:120px;text-align:right}
  .toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:var(--panel2);
    border:1px solid var(--line2);padding:10px 18px;border-radius:9px;font-size:13px;z-index:50;
    box-shadow:0 8px 30px rgba(0,0,0,.5);display:none}

  .liveprev{position:absolute;left:10px;bottom:10px;width:280px;background:rgba(8,12,16,.92);border:1px solid var(--line2);border-radius:10px;padding:10px;box-shadow:0 8px 28px rgba(0,0,0,.45);display:none;z-index:7}
  .liveprev .hd{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:8px}
  .liveprev .hd .tt{font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--dim)}
  .liveprev img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:8px;border:1px solid var(--line);background:#081018}
  .liveprev .meta{display:flex;justify-content:space-between;gap:10px;margin-top:8px;font-size:11px;color:var(--dim);font-family:'JetBrains Mono',monospace}
  .btn.stop{background:#5c1616;color:#ffd7d7}
  .side>.sec:last-child{position:sticky;bottom:0;background:linear-gradient(180deg,rgba(14,20,25,.92),#0e1419);box-shadow:0 -10px 28px rgba(0,0,0,.28);z-index:5}

</style>
<style id="pz-skin">
  /* ===== PZ MASK v30 skin — refined overrides (load order = wins) ===== */
  :root{ --acc:#2fe39a; --acc2:#34c3ff; }
  ::selection{background:rgba(47,227,154,.25)}
  .app{grid-template-rows:54px 1fr auto}
  .main{grid-template-columns:minmax(0,1fr) clamp(430px,27vw,520px)}
  .side::-webkit-scrollbar,.masks::-webkit-scrollbar{width:10px;height:10px}
  .side::-webkit-scrollbar-thumb,.masks::-webkit-scrollbar-thumb{background:#1b2630;border-radius:99px;border:2px solid var(--panel)}
  .side::-webkit-scrollbar-thumb:hover{background:#2a3a48}
  .side{scrollbar-width:thin;scrollbar-color:#1b2630 var(--panel)}

  /* inline icon system (currentColor) */
  .ic{width:18px;height:18px;flex:none;stroke:currentColor;stroke-width:1.9;
      stroke-linecap:round;stroke-linejoin:round;fill:none;display:inline-block;vertical-align:middle}
  .ic.s{stroke:none;fill:currentColor}
  .iconset{position:absolute;width:0;height:0;overflow:hidden}

  /* ---- topbar / brand ---- */
  .topbar{height:54px;gap:12px;padding:0 16px;background:linear-gradient(180deg,#0f161c,#0c1217);
      border-bottom:1px solid var(--line);backdrop-filter:blur(8px)}
  .brand{display:flex;align-items:center;gap:11px}
  .brand .mark{width:30px;height:30px;border-radius:9px;display:block;
      box-shadow:0 0 0 1px rgba(255,255,255,.07),0 6px 18px rgba(52,195,255,.18)}
  .brand .wm{font-weight:800;font-size:15px;letter-spacing:.3px;line-height:1.05}
  .brand .wm b{color:var(--acc)}
  .brand .wm .v{font-family:'JetBrains Mono',monospace;font-size:8.5px;color:var(--dim);
      letter-spacing:1.4px;display:block;margin-top:2px;font-weight:600}
  .tdiv{width:1px;height:26px;background:var(--line)}
  .topbar a.back{display:inline-flex;align-items:center;gap:6px;color:var(--dim);font-size:12.5px;
      padding:6px 11px;border:1px solid var(--line);border-radius:8px;transition:.14s}
  .topbar a.back:hover{color:var(--ink);border-color:var(--line2);background:#0d141a;transform:translateY(-1px)}
  .topbar .back .ic{width:15px;height:15px}
  .topbar .title{font-weight:700;font-size:14px;color:var(--ink);max-width:360px;overflow:hidden;
      text-overflow:ellipsis;white-space:nowrap}
  .topbar .pill{margin-left:2px}
  .top-preview{display:flex;align-items:center;gap:7px;margin-left:8px;white-space:nowrap}
  .top-preview .kpl{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--dim);letter-spacing:.4px;text-transform:uppercase}
  .top-preview select{width:auto;min-width:190px;max-width:260px;margin-top:0;padding:6px 28px 6px 9px;
    font-size:12px;border-radius:8px;background:#0a1015;border-color:#24414f;color:#dff7ff}
  .top-preview select:focus{outline:none;border-color:var(--acc2);box-shadow:0 0 0 3px rgba(52,195,255,.13)}
  @media(max-width:1250px){.top-preview .kpl{display:none}.top-preview select{min-width:155px;max-width:180px}}

  /* ---- side sections ---- */
  .sec{padding:16px}
  .sec h3{display:flex;align-items:center;gap:8px;margin:0 0 13px;font-size:10.5px;letter-spacing:1.5px}
  .sec h3 .ic{width:14px;height:14px;color:var(--acc);opacity:.95}

  /* ---- tool tiles ---- */
  .tools{gap:7px}
  .tool{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;
      padding:11px 6px 9px;border-radius:11px;background:#0c1218;border:1px solid var(--line);
      font-size:11px;font-weight:600;color:var(--dim);
      transition:transform .12s,border-color .14s,background .14s,color .14s,box-shadow .14s}
  .tool .ic{width:21px;height:21px;color:#9fb0bd;transition:color .14s}
  .tool:hover{border-color:var(--line2);color:var(--ink);transform:translateY(-1px)}
  .tool:hover .ic{color:var(--ink)}
  .tool.on{background:radial-gradient(130% 120% at 50% -10%,#10362622 0%,#0c1f17 100%);
      border-color:var(--acc);color:var(--acc);
      box-shadow:0 0 0 1px rgba(47,227,154,.25),0 8px 18px -6px rgba(47,227,154,.35)}
  .tool.on .ic{color:var(--acc)}
  /* FG / BG segmented control */
  .seg{display:flex;border:1px solid var(--line);border-radius:11px;overflow:hidden;background:#0c1218;margin-top:8px}
  .seg .tool{flex:1;flex-direction:row;gap:7px;border:0;border-radius:0;background:transparent;padding:11px 8px;transform:none}
  .seg .tool+.tool{border-left:1px solid var(--line)}
  .seg .tool:hover{transform:none;background:#0e1820}
  .seg .tool.on{box-shadow:inset 0 0 0 1px rgba(47,227,154,.4)}
  .tool.on.bg{background:radial-gradient(130% 120% at 50% -10%,#3a141422 0%,#1f0d0d 100%);
      color:var(--err);box-shadow:inset 0 0 0 1px rgba(255,93,93,.4)}
  .tool.on.bg .ic{color:var(--err)}

  /* ---- sliders ---- */
  input[type=range]{-webkit-appearance:none;appearance:none;height:4px;border-radius:99px;
      background:linear-gradient(90deg,#243440,#1a2530);cursor:pointer}
  input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:15px;height:15px;border-radius:50%;
      background:var(--acc);border:2px solid #06120c;box-shadow:0 0 0 1px var(--acc),0 2px 7px rgba(0,0,0,.55);transition:transform .1s}
  input[type=range]::-webkit-slider-thumb:hover{transform:scale(1.14)}
  input[type=range]::-moz-range-thumb{width:14px;height:14px;border:2px solid #06120c;border-radius:50%;background:var(--acc)}
  #scrub{height:5px}
  #scrub::-webkit-slider-thumb{background:var(--acc2);box-shadow:0 0 0 1px var(--acc2),0 2px 7px rgba(0,0,0,.55)}
  .row{gap:12px;margin-top:12px;font-size:11.5px}
  .row .mono{min-width:50px;text-align:center;color:#aebcc7;background:#0c1218;border:1px solid var(--line);
      border-radius:6px;padding:3px 7px;font-size:11px}

  /* ---- selects / labels / checks ---- */
  select,.fld{background:#0c1218;border-radius:8px;padding:9px 11px;font-size:12.5px;transition:.14s}
  select:hover{border-color:var(--line2)}
  select:focus,.fld:focus{outline:none;border-color:var(--acc2);box-shadow:0 0 0 3px rgba(52,195,255,.13)}
  label.lbl{letter-spacing:.3px;color:#8b9aa7}
  .chk{font-size:12.5px;color:#c4d2dc;align-items:flex-start;line-height:1.4}
  .chk input{margin-top:1px}

  /* ---- mask rows ---- */
  .masks{gap:8px}
  .mk{border-radius:9px;padding:9px 10px}
  .mk:hover{border-color:var(--line2);background:#0f1820}
  .mk.on{box-shadow:0 0 0 1px rgba(52,195,255,.3)}
  .sw{width:14px;height:14px;border-radius:4px;box-shadow:0 0 0 1px rgba(0,0,0,.45),0 0 9px -2px currentColor}
  .mk .nm{font-size:12.5px}
  .mk .cnt{font-size:9.5px;letter-spacing:.2px}
  .mk .x{font-size:17px;width:22px;height:22px;border-radius:6px;display:grid;place-items:center;transition:.12s}
  .mk .x:hover{background:#2a1010;color:var(--err)}

  /* ---- buttons ---- */
  .btn{border-radius:9px;padding:12px 14px;font-size:13.5px;letter-spacing:.2px;gap:9px}
  .btn .ic{width:17px;height:17px}
  .btn:hover{transform:translateY(-1px)}
  .btn[disabled]{transform:none;box-shadow:none}
  .btn:not(.ghost):not(.blue):not(.stop){box-shadow:0 6px 16px -6px rgba(47,227,154,.5)}
  .btn.blue{box-shadow:0 6px 16px -6px rgba(52,195,255,.55)}
  .btn.ghost{color:#c4d2dc}
  .btn.ghost:hover{border-color:var(--acc);color:var(--acc)}
  #track{background:linear-gradient(135deg,var(--acc),#23c98a);font-weight:800;padding:13px 16px;font-size:14px}

  /* ---- timeline ---- */
  .timeline{padding:11px 16px;gap:14px;background:linear-gradient(0deg,#0f161c,#0c1217)}
  .tl-btn{width:38px;height:36px;border-radius:9px;transition:.13s}
  .tl-btn:hover{border-color:var(--acc);color:var(--acc);transform:translateY(-1px)}
  .tl-btn .ic{width:18px;height:18px}
  .fcount{font-size:12px}

  /* ---- viewport chrome ---- */
  .vp-hud,.vp-help{backdrop-filter:blur(6px);border-color:var(--line2)}
  .notready .box{border-radius:14px;box-shadow:0 26px 64px rgba(0,0,0,.55)}
  .liveprev{border-radius:12px}
</style>
</head>
